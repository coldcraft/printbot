# Ollama LLM
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=mistral

# Network Printer (reserved IP)
PRINTER_IP=192.168.x.x
PRINTER_PORT=9100
PRINTER_CODEPAGE=cp437

# Logging
LOG_DIR=/logs

# Prompts
SYSTEM_PROMPT_PATH=

# Contacts
CONTACTS_PATH=

# Rate Limiting
RATE_LIMIT_MESSAGES=5
RATE_LIMIT_WINDOW_MINUTES=3
RATE_LIMIT_COOLDOWN_MINUTES=15

# Message Constraints
MAX_MESSAGE_CHARS=500

# Question Context Fetching
QUESTION_CONTEXT_ENABLED=true
QUESTION_CONTEXT_TIMEOUT_SECONDS=6
QUESTION_CONTEXT_MAX_CHARS=1200

# Retry Settings
RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=2
RETRY_TIMEOUT_SECONDS=30

# Job Queue Settings
JOB_QUEUE_MAX_AGE_MINUTES=1440
JOB_QUEUE_STALE_AGE_MINUTES=120
QUEUE_WORKER_INTERVAL_SECONDS=10

# Telegram Bridge (leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# TextBee Outbound (leave blank to disable; replies in Telegram won't send SMS)
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# SMS Gateway by capcom6 — inbound webhook (local mode)
# Paste the signing key shown in the Android app. Leave blank to skip HMAC verification.
SMSGATE_SIGNING_KEY=

# SMS Gateway outbound (used by Telegram reply path)
# Burner phone's local-server URL + credentials shown on the app's Home tab.
SMSGATE_BASE_URL=
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
