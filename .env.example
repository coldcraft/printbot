# TextBee SMS Gateway
TEXTBEE_WEBHOOK_KEY=your_textbee_webhook_key_here

# Ollama LLM
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=mistral

# Network Printer (reserved IP)
PRINTER_IP=192.168.x.x
PRINTER_PORT=9100

# Logging
LOG_DIR=/logs
NAS_LOG_PATH=T:\Documents\Code\printbot\logs

# Email Alerts (Gmail)
GMAIL_USER=your_email@gmail.com
GMAIL_PASSWORD=your_app_specific_password_here
ALERTING_EMAIL=alert_recipient@email.com

# Rate Limiting
RATE_LIMIT_MESSAGES=5
RATE_LIMIT_WINDOW_MINUTES=3
RATE_LIMIT_COOLDOWN_MINUTES=15

# Message Constraints
MAX_MESSAGE_CHARS=500

# Retry Settings
RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=2
RETRY_TIMEOUT_SECONDS=30

# Job Queue Settings
JOB_QUEUE_MAX_AGE_MINUTES=1440
JOB_QUEUE_STALE_AGE_MINUTES=120
